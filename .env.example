# Públicas (frontend)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública da loja (SEO, Auth e-mails, redirects)
# DEVE ser https://www.atlascosmeticos.com — NÃO use *.vercel.app
# Configure o MESMO valor em:
# - Vercel → Environment Variables → NEXT_PUBLIC_SITE_URL
# - Supabase → Authentication → URL Configuration → Site URL
NEXT_PUBLIC_SITE_URL=https://www.atlascosmeticos.com

# Secretas (apenas servidor — sem NEXT_PUBLIC)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Dev local: contorna falha de envio de e-mail de confirmação (NUNCA use em produção)
# SUPABASE_BYPASS_EMAIL_CONFIRM=true

# SEO Merchant (opcional — dias de devolução quando página trocas-e-devolucoes existir)
# SEO_RETURN_DAYS=7
# SEO_HANDLING_DAYS_MAX=2

# PayoutBR — pagamento na loja (Pix + cartão tokenizado)
# https://payoutbr.readme.io/reference/introducao
PAYOUT_SECRET_KEY=sk_test_sua-chave-secreta
PAYOUT_PUBLIC_KEY=pk_test_sua-chave-publica
PAYOUT_API_URL=https://api.payoutbr.com.br/v1

# Resend — e-mail de confirmação de pedido
# Domínio atlascosmeticos.com precisa estar verificado no Resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Atlas Cosmeticos <atendimento@atlascosmeticos.com>
STORE_CONTACT_EMAIL=atendimento@atlascosmeticos.com

# Track7 — rastreio de pedidos (somente servidor)
# Use a URL oficial abaixo (api.track7.com.br NÃO responde / dá timeout)
TRACK7_API_KEY=sua-chave-track7
TRACK7_API_URL=https://track7.app/api/v1
